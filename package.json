{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "hrabovskyi.online — personal portfolio + blog",
  "scripts": {
    "dev": "next dev",
    "build": "npm run images && npm run cms:vendor && next build && npm run index",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "index": "pagefind --site out --output-subdir pagefind",
    "images": "node scripts/optimize-images.mjs",
    "cms:vendor": "cp node_modules/@sveltia/cms/dist/sveltia-cms.js public/admin/sveltia-cms.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "node scripts/check-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "caddy-test": "bash scripts/caddy-test.sh",
    "serve:prod": "bash scripts/serve-prod.sh"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.1",
    "@sveltia/cms": "^0.174.0",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pagefind": "^1.5.2",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
