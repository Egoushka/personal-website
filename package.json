{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "hrabovskyi.online — personal portfolio + blog",
  "scripts": {
    "dev": "next dev",
    "build": "npm run images && next build && npm run index",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "evidence": "node scripts/evidence.mjs",
    "new": "node scripts/new-post.mjs",
    "docs:pull": "node scripts/docs.mjs pull",
    "docs:verify": "node scripts/docs.mjs verify",
    "docs:check": "node scripts/docs.mjs check",
    "index": "pagefind --site out --output-subdir pagefind",
    "images": "node scripts/optimize-images.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "node scripts/check-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "caddy-test": "bash scripts/caddy-test.sh",
    "serve:prod": "bash scripts/serve-prod.sh"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
