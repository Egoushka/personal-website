# Cloudflare Pages headers — the second deploy path.
#
# The Pages translation of the `header` blocks in deploy/Caddyfile. Two of these
# are load-bearing rather than hardening: the CSP, which has to match or the
# mirror breaks search (Pagefind loads WASM) and the CMS; and the Content-Type
# on the OG cards, which next/og writes as EXTENSIONLESS files that every social
# scraper rejects without it.
#
# Strict-Transport-Security is deliberately absent, exactly as in the Caddyfile:
# it belongs to the layer terminating TLS for the browser.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/admin/sveltia-cms.js
  Cache-Control: public, max-age=86400, s-maxage=604800

/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600, s-maxage=86400

/writing/:slug/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600, s-maxage=86400
