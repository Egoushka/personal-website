# Internal static server for hrabovskyi.online.
# Listens on :80 inside the container (published to 100.64.0.4:8090).
# TLS, the public hostname, and the www->apex redirect are handled upstream
# by the edge. Keep this file plain HTTP.
#
# Cloudflare sits in front of the edge, so it can add, strip or override any of
# these. Set each header in exactly ONE place — browsers intersect duplicate CSP
# headers, which fails in ways that are painful to debug.
#
# Strict-Transport-Security is deliberately NOT set here: it must come from the
# layer that terminates TLS for the browser, which is Cloudflare, not this container.

:80 {
	root * /srv
	# zstd and gzip are all the standard Caddy build ships — there is no `br` without
	# a custom build, and Cloudflare re-compresses at the edge anyway.
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		# interest-cohort is intentionally absent — FLoC was abandoned in 2022 and
		# Chrome now logs it as an unrecognised feature.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# 'wasm-unsafe-eval' is for Pagefind, which loads its search index as WASM.
		# 'unsafe-inline' in script-src is unavoidable in a Next.js static export:
		# nonces require server-side rendering, and the App Router serialises its RSC
		# payload into inline <script>self.__next_f.push(...)</script> tags in every
		# prerendered file. See https://github.com/vercel/next.js/discussions/54152.
		# The directives that DO close real surface here are object-src, base-uri,
		# form-action and frame-ancestors.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

		-Server
	}

	# Content-hashed assets never change under the same URL.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML had no Cache-Control at all, so Cloudflare returned cf-cache-status:
	# DYNAMIC and every page view reached the origin. s-maxage lets the edge cache
	# while keeping browsers revalidating, so a deploy is visible immediately.
	@html path / *.html */
	header @html Cache-Control "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"

	@feeds path /feed.xml /atom.xml /feed.json /sitemap.xml /robots.txt
	header @feeds Cache-Control "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"

	# Not content-hashed, so it must not be immutable — it gets replaced in place.
	@downloads path /icon.svg /apple-icon.png /manifest.webmanifest
	header @downloads Cache-Control "public, max-age=3600, s-maxage=86400"

	# The CMS bundle is vendored at build and only changes when the dep does.
	@admin path /admin/sveltia-cms.js
	header @admin Cache-Control "public, max-age=86400, s-maxage=604800"

	# Pagefind's index is rewritten on every deploy, so it caches like an asset
	# but must not be immutable.
	@pagefind path /pagefind/*
	header @pagefind Cache-Control "public, max-age=3600, s-maxage=86400"

	# next/og writes these as EXTENSIONLESS files (out/opengraph-image,
	# out/writing/<slug>/opengraph-image), so a file server has nothing to infer a
	# MIME type from and every social scraper rejects the card. Set it explicitly.
	@ogimages path /opengraph-image /writing/*/opengraph-image
	header @ogimages {
		Content-Type "image/png"
		Cache-Control "public, max-age=3600, s-maxage=86400"
	}

	# ── routes that moved, 2026-08 ────────────────────────────────────────────
	# A static export cannot redirect — `redirects` in next.config hard-errors
	# under output: "export" — so the old URLs live here or they 404. These are
	# permanent and they are load-bearing: /posts/<slug>/ was the canonical
	# address of everything ever published here, and it is in feed readers.
	#
	# `handle` blocks rather than bare `redir`, because bare directives are sorted
	# into Caddy's own order and try_files would rewrite the path out from under
	# the matcher before it ever ran. handle blocks are evaluated top to bottom
	# and the first match wins.
	#
	# The `*` on every redir is NOT decoration. `redir` is
	# `redir [<matcher>] <to> [<code>]`, and a first argument beginning with `/`
	# is parsed as a PATH MATCHER — so `redir /writing/ permanent` means "match
	# /writing/, redirect to the literal URL `permanent`". The explicit wildcard
	# is what makes the destination a destination.
	#
	# The (.+) capture covers the OG card too: /posts/foo/opengraph-image lands on
	# /writing/foo/opengraph-image, which is where next/og writes it now.
	@oldpost path_regexp oldpost ^/posts/(.+)$
	handle @oldpost {
		redir * /writing/{re.oldpost.1} permanent
	}

	@oldtag path_regexp oldtag ^/tags/(.+)$
	handle @oldtag {
		redir * /topics/{re.oldtag.1} permanent
	}

	handle /blog* {
		redir * /writing/ permanent
	}
	handle /resume* {
		redir * /cv/ permanent
	}
	# /now/ and /uses/ are sections of /about/ now, not pages.
	handle /now* {
		redir * /about/ permanent
	}
	handle /uses* {
		redir * /about/ permanent
	}

	handle {
		# Next static export uses trailingSlash: dir/index.html
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
