# Internal static server for hrabovskyi.online.
# Listens on :80 inside the container (published to 100.64.0.4:8090).
# TLS, the public hostname, and the www->apex redirect are handled upstream
# by the edge "headscale-caddy". Keep this file plain HTTP.

:80 {
	root * /srv
	encode gzip zstd
	file_server

	# Next static export uses trailingSlash: dir/index.html
	try_files {path} {path}/index.html {path}.html

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@assets path /_next/static/* /cv.pdf
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
